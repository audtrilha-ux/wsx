# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# JWT_SECRET: Required in production mode to sign user session tokens.
# Must be a secure random 32-character or longer string.
JWT_SECRET=

# HQ Admin Initial Provisioning (Optional in dev, required in prod)
HQ_ADMIN_EMAIL=
HQ_ADMIN_PASSWORD=
HQ_ADMIN_SECRET=
HQ_ADMIN_MFA_SECRET=

# MFA_ENCRYPTION_KEY: Independent AES-256-GCM encryption key for multi-factor credentials in DB.
MFA_ENCRYPTION_KEY=


